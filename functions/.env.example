SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Lepharo Smart Incubation Support <no-reply@example.com>"
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Lepharo Smart Incubation Support
MAIL_REPLY_TO=support@example.com
APP_LOGIN_URL=https://lepharosmartinc.co.za/login
APP_BASE_URL=https://lepharosmartinc.co.za

# SME reminder emails (remindSmmeDpConfirmation, intervention/compliance reminders)
# send through Brevo's transactional API instead of SMTP, since only the API path
# fires bounce/complaint webhooks. Get BREVO_API_KEY from the Brevo dashboard;
# BREVO_WEBHOOK_TOKEN is a random secret you generate and also give to Brevo when
# registering the webhook (see the bounce-tracking plan for the exact curl command).
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_WEBHOOK_TOKEN=replace-with-a-random-secret

# Training Academy coach: the Gemini call runs in the AI backend (POST /api/academy/coach).
# Point this at the deployed AI backend, and store ACADEMY_COACH_SECRET with
# firebase functions:secrets:set (not here). It must equal ACADEMY_COACH_SECRET on the AI backend.
AI_BACKEND_URL=https://your-ai-backend.example.com

# QuantNow finance-admin login (same account the Finance page uses via
# VITE_QX_FINANCE_EMAIL/PASSWORD) - revenueMetricsSyncCron uses it to list
# SME companies and sync each one's monthly revenue into Firestore.
QX_FINANCE_EMAIL=replace-with-quantnow-admin-email
QX_FINANCE_PASSWORD=replace-with-quantnow-admin-password
