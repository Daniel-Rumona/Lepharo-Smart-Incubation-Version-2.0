rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Global super-admin escape hatch for collection-wide admin tooling.
    // Prefer the custom claim when present; fall back to the users/{uid} role.
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['system_admin', 'superadmin'] ||
        currentUser().role in ['system_admin', 'superadmin']
      );
    }

    // ---- Audience: internal staff vs external logins ----
    // Every account has a users/{uid} doc (registration, createPlatformUser,
    // training logins), so the stored role decides the audience. Spelling
    // variants seen in stored data are listed rather than normalised away.
    function staffRoles() {
      return [
        'system_admin', 'system admin', 'superadmin', 'admin', 'director',
        'operations', 'head of department', 'hod', 'headofdepartment',
        'projectadmin', 'project admin', 'project_admin', 'center coordinator', 'center_coordinator',
        'coordinator', 'receptionist', 'employee', 'hr', 'projectmanager', 'consultant', 'auxiliary'
      ];
    }
    function adminRoles() {
      return ['system_admin', 'system admin', 'superadmin', 'admin'];
    }
    function hasProfile() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return currentUser().get('role', '').lower().trim();
    }
    function isStaff() {
      return isSuperAdmin() || (hasProfile() && myRole() in staffRoles());
    }
    // Funders (and government viewers) are read-only, scoped to the
    // programmes on their users doc.
    function isFunderUser() {
      return hasProfile() && myRole() in ['funder', 'government'];
    }
    function funderSeesProgram(programId) {
      return isFunderUser() && programId in currentUser().get('assignedPrograms', []);
    }

    // ---- SME ownership ----
    // An SME's records are linked to their login only by email: participants
    // and applications carry `email` (applications also `applicantEmail`) and
    // nothing stores the auth uid. Firebase Auth emails are lower case; the
    // exact comparison comes first so equality queries can be proven.
    function isMyEmail(value) {
      return request.auth != null && request.auth.token.get('email', '') != '' && (
        value == request.auth.token.email ||
        (value is string && value.lower() == request.auth.token.email.lower())
      );
    }
    function ownsParticipant(pid) {
      return request.auth != null && pid is string && pid != '' && (
        (hasProfile() && currentUser().get('participantId', '') == pid) ||
        isMyEmail(get(/databases/$(database)/documents/participants/$(pid)).data.email)
      );
    }
    function ownsApplicationData(data) {
      return isMyEmail(data.email) || isMyEmail(data.applicantEmail) || ownsParticipant(data.participantId);
    }
    function ownsApplication(appId) {
      return appId is string && appId != '' &&
        ownsApplicationData(get(/databases/$(database)/documents/applications/$(appId)).data);
    }
    // Some SME screens key records on the application id instead of the
    // participant id (smeFeedback falls back to it).
    function ownsSmeRecord(id) {
      return ownsParticipant(id) || ownsApplication(id);
    }
    function ownsAssignment(assignmentId) {
      return assignmentId is string && assignmentId != '' &&
        ownsParticipant(get(/databases/$(database)/documents/assignedInterventions/$(assignmentId)).data.participantId);
    }

    // Which department plays which role (ROM, M&E, HR, ...): { roleKey: departmentId }.
    function departmentRoles() {
      return get(/databases/$(database)/documents/systemSettings/departmentRoles).data;
    }

    // The user's department, or its parent, is the department assigned to `role`.
    function userDepartmentHasRole(role) {
      let deptId = currentUser().get('departmentId', '');
      let roleDeptId = departmentRoles().get(role, '');
      return deptId != '' && roleDeptId != '' && (
        deptId == roleDeptId ||
        get(/databases/$(database)/documents/departments/$(deptId)).data.get('parentDepartmentId', '') == roleDeptId
      );
    }

    function isHrManager() {
      return request.auth != null &&
        (
          currentUser().role == 'hr' ||
          (currentUser().role == 'operations' && userDepartmentHasRole('hr'))
        );
    }

    // Coverage is recorded by the session facilitator or a delivery manager.
    // This is deliberately narrower than general appointment editing.
    function canRecordAppointmentCoverage(data) {
      return request.auth != null &&
        (
          (data.keys().hasAny(['assigneeId']) && data.assigneeId == request.auth.uid) ||
          currentUser().role in ['director', 'system_admin', 'operations', 'projectadmin', 'coordinator']
        );
    }

    // Training Academy SME logins (role training_sme). participantId is the
    // company's trainingEnrollments id, for its director and for every
    // employee; trainingAttendeeId is the person (trainingAttendees).
    // trainingRole 'director' is the SME's owner -- not the platform role
    // 'director', which is why role is always checked too.
    function isTrainingSme() {
      return request.auth != null && currentUser().get('role', '') == 'training_sme';
    }
    function isTrainingCompanyMember(enrollmentId) {
      return isTrainingSme() && enrollmentId is string && enrollmentId != '' &&
        currentUser().get('participantId', '') == enrollmentId;
    }
    function isTrainingCompanyDirector(enrollmentId) {
      return isTrainingCompanyMember(enrollmentId) &&
        currentUser().get('trainingRole', '') == 'director';
    }

    // Users collection. Nobody may change their own role or the fields that
    // decide what they can see; only a super-admin grants an admin role.
    match /users/{userId} {
      function privilegedUserFields() {
        return ['role', 'departmentId', 'department', 'departmentName', 'assignedBranch', 'branchId',
          'assignedPrograms', 'participantId', 'trainingRole', 'trainingAttendeeId', 'companyCode',
          'status', 'permissions', 'acceptance'];
      }
      function isAdminRole(data) {
        return data.get('role', '').lower().trim() in adminRoles();
      }
      allow read, write: if isSuperAdmin();

      // Own doc. Self-registration creates it as an SME (registration/index.tsx).
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('role', '') == 'incubatee' &&
        !request.resource.data.keys().hasAny(privilegedUserFields().removeAll(['role']));
      allow update: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFields());

      // Staff read the directory and manage other people's docs (user
      // management, HR, application decisions), but not admins' docs.
      allow read: if isStaff();
      allow create: if isStaff() && request.auth.uid != userId && !isAdminRole(request.resource.data);
      allow update: if isStaff() && request.auth.uid != userId &&
        !isAdminRole(resource.data) && !isAdminRole(request.resource.data);
      allow delete: if isStaff() && request.auth.uid != userId && !isAdminRole(resource.data);

      // External logins see staff profiles (facilitators, HODs), their own doc
      // by email or uid query, and funders the task assignee list.
      allow get: if request.auth != null && resource.data.get('role', '').lower().trim() in staffRoles();
      allow read: if isMyEmail(resource.data.email) || resource.data.uid == request.auth.uid;
      allow read: if isFunderUser();

      match /{subcollection}/{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Branches collection - directors can manage, others can read within company
    match /branches/{branchId} {
      // Names and operating hours; SME and funder screens show them too.
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
      allow update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // Branch assignment audit - read only for directors and admins
    match /branchAssignmentAudit/{auditId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'system_admin'];
      allow write: if false; // Only system/server can write audit logs
    }

    // Departments collection - directors manage. Every signed-in user can read
    // them: records store only a departmentId and look the name up here.
    match /departments/{departmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // System-wide settings such as departmentRoles. Readable by every
    // signed-in user because menus and dashboards depend on them.
    match /systemSettings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() ||
        (request.auth != null && currentUser().role == 'director');
    }

    // Quality Objectives (LEP-QMS 024 F) - directors manage all departments'
    // objectives; HR (role 'hr', or operations scoped to an HR department)
    // can also manage them. Everyone else with company-wide read access can
    // view, scoped to their own company.
    match /qualityObjectives/{qualityObjectiveId} {
      allow read, write: if isSuperAdmin();
      allow read: if request.auth != null &&
        (
          currentUser().role in ['director', 'system_admin', 'operations', 'projectadmin'] ||
          isHrManager()
        );
      allow create: if request.auth != null &&
        (currentUser().role == 'director' || isHrManager());
      allow update, delete: if request.auth != null &&
        (currentUser().role == 'director' || isHrManager());
    }


    // Leave requests - the requester can create/read their own and edit it
    // while still pending (fixing a mistake); HR/director can manage every
    // request within their company regardless of status.
    match /leaveRequests/{requestId} {
      allow read, write: if isSuperAdmin();
      allow read: if request.auth != null &&
        (
          resource.data.employeeId == request.auth.uid ||
          (
            resource.data.keys().hasAny(['employeeEmail']) &&
            currentUser().keys().hasAny(['email']) &&
            resource.data.employeeEmail == currentUser().email
          ) ||
          (
            (currentUser().role in ['director', 'system_admin', 'operations', 'projectadmin'] || isHrManager())
          )
        );
      allow create: if request.auth != null &&
        (
          request.resource.data.employeeId == request.auth.uid ||
          (
            (currentUser().role == 'director' || isHrManager())
          )
        );
      allow update: if request.auth != null &&
        (
          (
            resource.data.employeeId == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.employeeId == resource.data.employeeId &&
            request.resource.data.status == 'pending'
          ) ||
          (
            (currentUser().role == 'director' || isHrManager())
          )
        );
      allow delete: if request.auth != null &&
        (currentUser().role == 'director' || isHrManager());
    }

    // Department reading library. Operations publish only for their assigned
    // department; SMEs can browse material from every department.
    match /libraryMaterials/{materialId} {
      function libraryUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isSme() {
        return libraryUser().role in ['incubatee', 'participant'];
      }
      function isOperations() {
        return libraryUser().role == 'operations';
      }
      function isOwnDepartment(data) {
        return libraryUser().get('departmentId', '') != '' && data.get('departmentId', '') == libraryUser().departmentId;
      }

      allow read: if request.auth != null && (isSme() || (isOperations() && isOwnDepartment(resource.data)));
      allow create: if request.auth != null && isOperations() &&
        request.resource.data.uploadedBy == request.auth.uid &&
        isOwnDepartment(request.resource.data);
      allow update, delete: if request.auth != null && isOperations() &&
        resource.data.uploadedBy == request.auth.uid && isOwnDepartment(resource.data);
    }

    match /dataExportSettings/{departmentId} {
      function exportSettingsUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      allow read: if request.auth != null && (
        exportSettingsUser().role == 'system_admin' ||
        (exportSettingsUser().departmentId != null && exportSettingsUser().departmentId == departmentId)
      );
      allow create, update, delete: if request.auth != null && exportSettingsUser().role == 'system_admin';
    }

    // Canonical v5 appointment model: one invitation per SME, linked to one
    // real session and one current assigned intervention.
    match /appointments/{appointmentId} {
      allow read, write: if isSuperAdmin();
      function linkedSessionIsValid(data) {
        return data.appointmentSessionId is string && data.appointmentSessionId.size() > 0 &&
          getAfter(/databases/$(database)/documents/appointmentSessions/$(data.appointmentSessionId)).data.programId == data.programId &&
          getAfter(/databases/$(database)/documents/appointmentSessions/$(data.appointmentSessionId)).data.departmentId == data.departmentId &&
          getAfter(/databases/$(database)/documents/appointmentSessions/$(data.appointmentSessionId)).data.interventionId == data.interventionId;
      }
      function canonicalAppointment(data) {
        return data.schemaVersion == 5 &&
          data.keys().hasOnly(['schemaVersion','programId','departmentId','assignedInterventionId','appointmentSessionId','smeId','smeName','smeEmail','attendeeId','attendeeName','attendeeKind','dataOrigin','suppressNotifications','interventionId','interventionTitle','subInterventionId','subInterventionTitle','cycleKey','assigneeId','assigneeName','assigneeEmail','assigneeRole','groupKey','status','smeConfirmation','smeDeclineReason','smeRescheduleRequest','attendance','foodSelections','createdAt','updatedAt','completedAt']) &&
          data.smeId is string && data.interventionId is string &&
          data.status in ['scheduled','in_progress','completed','cancelled','postponed'] &&
          data.smeConfirmation in ['pending','confirmed','declined'];
      }
      // QR start only moves an existing invitation into the in-progress state.
      // Keep this deliberately narrow so legacy invitations with additional
      // historical fields can still participate without permitting general
      // edits outside the canonical schema.
      function isQrInvitationStart() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'in_progress';
      }
      // The signed-in person an invitation is for. A Training Academy
      // invitation names its person (attendeeId) and only that login matches:
      // everyone from the same SME shares its smeId. Every other invitation
      // keeps the older smeId / participantId / email identity -- except for
      // a training employee: an SME-wide invitation (sent before the SME's
      // people were set up) was its director's.
      function isInvitationPerson(data) {
        return request.auth != null && (
          (data.get('attendeeId', null) is string &&
            currentUser().get('trainingAttendeeId', '') == data.attendeeId) ||
          (!(data.get('attendeeId', null) is string) &&
            currentUser().get('trainingRole', '') != 'employee' && (
            data.get('smeId', '') == request.auth.uid ||
            (currentUser().get('participantId', '') != '' &&
              data.get('smeId', '') == currentUser().get('participantId', '')) ||
            (data.get('smeEmail', null) is string && currentUser().get('email', '') is string &&
              currentUser().get('email', '') != '' &&
              data.smeEmail.lower() == currentUser().get('email', '').lower())
          ))
        );
      }
      // A signed-in SME can confirm their own attendance through the active
      // QR session -- only on their own invitation (the facilitator and
      // delivery managers may too). This also works for historic invitations
      // that have fields outside the strict v5 schema.
      function isQrInvitationCheckIn() {
        return (isInvitationPerson(resource.data) || canRecordAppointmentCoverage(resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendance', 'smeConfirmation', 'updatedAt']) &&
          request.resource.data.attendance.status == 'attended' &&
          request.resource.data.smeConfirmation == 'confirmed' &&
          getAfter(/databases/$(database)/documents/appointmentSessions/$(resource.data.appointmentSessionId)).data.attendanceSession.status == 'active';
      }
      // Incubatee responses must also work on historic appointment documents
      // that contain fields outside the strict v5 schema. The SME may only
      // change their own response fields, never the schedule or linkage. A
      // training SME's director may also answer for the company's people.
      function isOwnSmeResponse() {
        return request.auth != null &&
          (
            isInvitationPerson(resource.data) ||
            (resource.data.get('attendeeId', null) is string &&
              isTrainingCompanyDirector(resource.data.get('smeId', '')))
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'smeConfirmation',
            'smeDeclineReason',
            'smeRescheduleRequest',
            'foodSelections',
            'updatedAt'
          ]) &&
          request.resource.data.smeConfirmation in ['pending', 'confirmed', 'declined'];
      }
      // Coverage updates must support legacy invitation records, which may
      // have fields outside the strict v5 schema. Only the delivery outcome,
      // attendance and the audit timestamps may change here.
      function isCoverageInvitationPatch() {
        return canRecordAppointmentCoverage(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'attendance', 'status', 'completedAt', 'updatedAt',
            'assignedInterventionId', 'assignmentLinkRepairedAt'
          ]) &&
          request.resource.data.status in ['scheduled', 'completed'];
      }
      // Staff see every invitation; an SME their own (and a training SME's
      // director their company's). While a session's QR check-in is open,
      // invitees read that session's invitation list to find their own.
      allow read: if isStaff() ||
        isInvitationPerson(resource.data) ||
        ownsParticipant(resource.data.smeId) ||
        isTrainingCompanyDirector(resource.data.smeId) ||
        (request.auth != null &&
          get(/databases/$(database)/documents/appointmentSessions/$(resource.data.appointmentSessionId)).data.attendanceSession.status == 'active');
      // A grouped session can create many invitations in one transaction.
      // Do not read every assigned intervention from a rule: Firestore caps
      // rule reads in atomic operations, which otherwise rejects valid groups
      // as a permission error. The shared session link remains validated with
      // one getAfter lookup, while the client transaction uses deterministic
      // session and invitation IDs to prevent duplicate scheduling.
      allow create: if isStaff() &&
        canonicalAppointment(request.resource.data) &&
        linkedSessionIsValid(request.resource.data);
      // A linked appointment cannot be repointed. Do not require the
      // assignment to remain open here: historic declines may have cancelled
      // it, while the appointment still needs an SME confirmation or a new
      // proposed time.
      allow update: if request.auth != null &&
        (
          (
            isStaff() &&
            canonicalAppointment(request.resource.data) &&
            request.resource.data.assignedInterventionId == resource.data.assignedInterventionId &&
            request.resource.data.appointmentSessionId == resource.data.appointmentSessionId &&
            request.resource.data.smeId == resource.data.smeId && linkedSessionIsValid(request.resource.data)
          ) ||
          isOwnSmeResponse() ||
          isQrInvitationStart() ||
          isQrInvitationCheckIn() ||
          isCoverageInvitationPatch()
        );
      allow delete: if isStaff();
    }

    match /appointmentSessions/{sessionId} {
      allow read, write: if isSuperAdmin();
      function canonicalSession(data) {
        return data.schemaVersion == 5 &&
          data.keys().hasOnly(['schemaVersion','programId','departmentId','interventionId','interventionTitle','cycleKey','groupKey','sessionType','assigneeId','assigneeName','assigneeEmail','assigneeRole','title','startAt','endAt','deliveryMethod','location','meetingLink','plannedTopics','category','dataOrigin','suppressNotifications','plannedCoverage','coverage','attendanceSession','attendanceSummary','foodMenu','scheduleHistory','status','createdAt','updatedAt','completedAt']) &&
          data.sessionType in ['individual','group'] &&
          data.status in ['scheduled','in_progress','completed','cancelled','postponed'];
      }
      // QR start/close and attendee check-in change only attendance state.
      // This supports historical sessions that predate the strict v5 field set.
      function isQrAttendancePatch() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendanceSession', 'attendanceSummary', 'status', 'updatedAt']) &&
          request.resource.data.status in ['scheduled', 'in_progress'];
      }
      // Like invitations, older session records are valid operational data but
      // do not satisfy the strict v5 shape. Permit only the coverage outcome
      // patch made by the assigned facilitator or a delivery manager.
      function isCoverageSessionPatch() {
        return canRecordAppointmentCoverage(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'plannedCoverage', 'coverage', 'status', 'completedAt', 'updatedAt'
          ]) &&
          request.resource.data.coverage.recordedById == request.auth.uid &&
          request.resource.data.status in ['scheduled', 'completed'];
      }
      allow read: if request.auth != null;
      allow create: if isStaff() && canonicalSession(request.resource.data);
      allow update: if request.auth != null &&
        ((isStaff() && canonicalSession(request.resource.data)) || isQrAttendancePatch() || isCoverageSessionPatch());
      allow delete: if isStaff();
    }

    // Staff reach these through the staff fallback below. An SME reads and
    // answers (accept, decline, confirm, dispute) only their own; funders
    // read their programmes'.
    match /assignedInterventions/{assignmentId} {
      allow read: if ownsParticipant(resource.data.participantId) ||
        ownsApplication(resource.data.applicationId);
      allow read: if funderSeesProgram(resource.data.programId);
      allow update: if ownsParticipant(resource.data.participantId) &&
        request.resource.data.participantId == resource.data.participantId;
    }

    // An HOD ending support for one SME. Only HODs and admins write these; a
    // closure is reopened rather than deleted, so the history always remains.
    match /interventionClosures/{closureId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        currentUser().role in ['operations', 'system_admin'];
      allow delete: if false;
    }

    // Outcome check-backs. Created, scheduled and closed by Cloud Functions
    // (outcomeFollowUps.ts). A client may only record a first answer:
    //  - the assigned facilitator, or an operations/admin user (the HOD),
    //    sets `answer` (+ optional note), and may only name themselves;
    //  - the SME sets `smeAnswer`, matched by the email captured when the
    //    check-back was scheduled.
    // Answers are one-way, so a recorded assessment cannot be quietly changed.
    match /outcomeFollowUps/{followUpId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answer', 'answerNote', 'answeredVia', 'answeredBy']) &&
          request.resource.data.answer in ['not_yet', 'partial', 'achieved'] &&
          !resource.data.keys().hasAny(['answer']) &&
          (!request.resource.data.keys().hasAny(['answeredBy']) || request.resource.data.answeredBy == request.auth.uid) &&
          (
            resource.data.assigneeId == request.auth.uid ||
            currentUser().role in ['operations', 'system_admin']
          )
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['smeAnswer']) &&
          request.resource.data.smeAnswer in ['yes', 'partly', 'no'] &&
          !resource.data.keys().hasAny(['smeAnswer']) &&
          resource.data.smeCheckIn == true &&
          resource.data.participantEmail != '' &&
          currentUser().role == 'incubatee' &&
          currentUser().email.lower() == resource.data.participantEmail
        )
      );
    }

    // Append-only record of every outcome judgement, with who and how. Written
    // only by the Cloud Function that derives its confidence.
    match /outcomeAssessments/{assessmentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agreementTemplates/{templateId} {
      allow read, write: if isSuperAdmin();
      function agreementTemplateUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isAgreementTemplateAdmin() {
        return agreementTemplateUser().role in ['system admin', 'system_admin'];
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        isAgreementTemplateAdmin();
      allow update, delete: if request.auth != null &&
        isAgreementTemplateAdmin();
    }

    // Proposal access is shared by all authenticated non-incubatee roles.
    // Many consultants/coordinators/operationsStaff have no mirrored
    // users/{uid} doc, and currentUser() throws (permission denied) when that
    // doc doesn't exist - so check existence first, and treat being known in
    // one of those staff-only collections as sufficient proof of not being an
    // incubatee (incubatees are never recorded there).
    function canAccessProposals() {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUser().role is string &&
          currentUser().role.lower().trim() != 'incubatee'
        ) ||
        exists(/databases/$(database)/documents/consultants/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/coordinators/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/operationsStaff/$(request.auth.uid))
      );
    }

    match /projectProposals/{proposalId} {
      allow read, create, update, delete: if canAccessProposals();

      match /{subcollection}/{entryId} {
        allow read, create, update, delete: if canAccessProposals();
      }
    }

    match /proposalCounters/{counterId} {
      allow read, create, update: if canAccessProposals();
      allow delete: if false;
    }

    // Digital notice board. Authenticated users can read current notices;
    // only branch-scoped receptionists and center coordinators can manage them.
    match /noticeBoard/{noticeId} {
      allow read, write: if isSuperAdmin();
      function noticeUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isNoticeManager() {
        return noticeUser().role in ['receptionist', 'projectadmin'];
      }
      function isOwnNoticeBranch(data) {
        return noticeUser().assignedBranch != null &&
               data.branchId == noticeUser().assignedBranch;
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        isNoticeManager() &&
        isOwnNoticeBranch(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null &&
        isNoticeManager() &&
        isOwnNoticeBranch(resource.data) &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if request.auth != null &&
        isNoticeManager() &&
        isOwnNoticeBranch(resource.data);
    }

    // Inquiry collection - branch scoped with role-based access
    match /inquiries/{inquiryId} {
      allow read, write: if isSuperAdmin();
      function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isValidBranchAccess() {
        return request.auth != null && (
          // Receptionists can access their assigned branch
          (getUserData().role == 'receptionist' &&
           getUserData().assignedBranch != null) ||
          // Center coordinators can access their assigned branch
          (getUserData().role == 'projectadmin' &&
           getUserData().assignedBranch != null) ||
          // Directors can access all inquiries
          (getUserData().role == 'director') ||
          // Admins can access all inquiries
          (getUserData().role == 'system_admin')
        );
      }

      // An SME (applicant or incubatee) manages the inquiries they submitted.
      allow create: if request.auth != null && request.resource.data.submittedBy == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.submittedBy == request.auth.uid;
      allow read: if ownsParticipant(resource.data.participantId);
      allow update: if request.auth != null && resource.data.submittedBy == request.auth.uid &&
        request.resource.data.submittedBy == request.auth.uid;

      // Allow list/query operations for authorized users (they will be filtered by the client)
      allow list: if isValidBranchAccess();

      // Allow get operations with branch verification for non-directors/admins
      allow get: if request.auth != null && (
        (getUserData().role in ['receptionist', 'projectadmin'] &&
         getUserData().assignedBranch == resource.data.branchId) ||
        (getUserData().role == 'director') ||
        (getUserData().role == 'system_admin')
      );

      // Create permissions
      allow create: if request.auth != null && (
        (getUserData().role == 'receptionist' &&
         getUserData().assignedBranch == request.resource.data.branchId) ||
        (getUserData().role == 'projectadmin' &&
         getUserData().assignedBranch == request.resource.data.branchId) ||
        (getUserData().role == 'director') ||
        (getUserData().role == 'system_admin')
      );

      // Update permissions
      allow update: if request.auth != null && (
        // Receptionists can update any inquiry in their assigned branch
        (getUserData().role == 'receptionist' &&
         getUserData().assignedBranch == resource.data.branchId) ||
        // Center coordinators can update any inquiry in their branch
        (getUserData().role == 'projectadmin' &&
         getUserData().assignedBranch == resource.data.branchId) ||
        // Directors can update all inquiries
        (getUserData().role == 'director') ||
        // Admins can update all inquiries
        (getUserData().role == 'system_admin') ||
        // Soft delete permission for directors and admins
        ((getUserData().role == 'director' || getUserData().role == 'system_admin') &&
         request.resource.data.keys().hasOnly(['isActive', 'updatedAt']) &&
         request.resource.data.isActive == false)
      );
    }

    // Follow-ups collection - branch scoped with role-based access
    match /followUps/{followUpId} {
      allow read, write: if isSuperAdmin();
      function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isValidBranchAccess() {
        return request.auth != null && (
          // Receptionists can access their assigned branch
          (getUserData().role == 'receptionist' &&
           getUserData().assignedBranch != null) ||
          // Center coordinators can access their assigned branch
          (getUserData().role == 'projectadmin' &&
           getUserData().assignedBranch != null) ||
          // Directors can access all follow-ups
          (getUserData().role == 'director') ||
          // Admins can access all follow-ups
          (getUserData().role == 'system_admin')
        );
      }

      // An applicant schedules a follow-up on their own inquiry, assigned to themselves.
      allow create: if request.auth != null && request.resource.data.assignedTo == request.auth.uid;
      allow read: if request.auth != null && resource.data.assignedTo == request.auth.uid;

      // Allow list/query operations for authorized users (they will be filtered by the client)
      allow list: if isValidBranchAccess();

      // Allow get operations with branch verification for non-directors/admins
      allow get: if request.auth != null && (
        (getUserData().role in ['receptionist', 'projectadmin'] &&
         getUserData().assignedBranch == resource.data.branchId) ||
        (getUserData().role == 'director') ||
        (getUserData().role == 'system_admin')
      );

      // Create permissions
      allow create: if request.auth != null && (
        (getUserData().role == 'receptionist' &&
         getUserData().assignedBranch == request.resource.data.branchId) ||
        (getUserData().role == 'projectadmin' &&
         getUserData().assignedBranch == request.resource.data.branchId) ||
        (getUserData().role == 'director') ||
        (getUserData().role == 'system_admin')
      );

      // Update permissions
      allow update: if request.auth != null && (
        // Receptionists can update follow-ups in their assigned branch
        (getUserData().role == 'receptionist' &&
         getUserData().assignedBranch == resource.data.branchId) ||
        // Center coordinators can update any follow-up in their branch
        (getUserData().role == 'projectadmin' &&
         getUserData().assignedBranch == resource.data.branchId) ||
        // Directors can update all follow-ups
        (getUserData().role == 'director') ||
        // Admins can update all follow-ups
        (getUserData().role == 'system_admin')
      );
    }

    // Implementation-plan roadmaps. Drafted from an uploaded plan, reviewed by
    // the HOD (operations, in the same department), then published. The
    // check-in cron (planRoadmapCheckIns.ts) uses the admin SDK, so clients
    // never write its bookkeeping fields meaningfully.
    match /planRoadmaps/{roadmapId} {
      function roadmapUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function canManageRoadmap(departmentId) {
        return request.auth != null && (
          roadmapUser().role in ['system_admin', 'director', 'projectadmin'] ||
          (roadmapUser().role == 'operations' && roadmapUser().departmentId == departmentId)
        );
      }

      allow read: if request.auth != null;
      allow create: if canManageRoadmap(request.resource.data.departmentId) &&
        request.resource.data.status == 'draft';
      allow update: if canManageRoadmap(resource.data.departmentId) &&
        request.resource.data.departmentId == resource.data.departmentId;
      allow delete: if canManageRoadmap(resource.data.departmentId) && resource.data.status == 'draft';

      match /milestones/{milestoneId} {
        allow read: if request.auth != null;
        allow create, update, delete: if canManageRoadmap(
          get(/databases/$(database)/documents/planRoadmaps/$(roadmapId)).data.departmentId);
      }
    }

    // KPI targets are performance commitments. New targets must be committed
    // before their reporting period begins; after that only an immutable
    // revision record may be added.
    match /kpiTargets/{targetId} {
      allow read: if request.auth != null;
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll(['kpiId', 'periodType', 'periodKey', 'periodStartAt', 'target']) &&
        request.resource.data.periodStartAt > request.time;
      allow update: if isStaff() &&
        (
          // Existing records created before periodStartAt was introduced stay
          // manageable through the application-level compatibility guard.
          !resource.data.keys().hasAll(['periodStartAt']) ||
          (
            resource.data.kpiId == request.resource.data.kpiId &&
            resource.data.periodStartAt > request.time &&
            request.resource.data.periodStartAt > request.time
          )
        );
      allow delete: if isStaff() &&
        (!resource.data.keys().hasAll(['periodStartAt']) || resource.data.periodStartAt > request.time);
    }

    match /kpiTargetRevisions/{revisionId} {
      allow read: if request.auth != null;
      allow create: if isStaff() &&
        request.resource.data.status == 'approved' &&
        request.resource.data.approvedBy == request.auth.uid &&
        request.resource.data.targetDocId is string &&
        request.resource.data.kpiId is string;
      allow update, delete: if false;
    }

    match /kpiTargetAuditLogs/{auditId} {
      allow read: if request.auth != null;
      allow create: if isStaff() && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Default rule for other collections - temporary, should be made more specific.
    // Super-admins can access every collection, including the explicitly restricted
    // collections above. Other authenticated users retain the previous fallback.
    function academyAuthor() {
      return request.auth != null && currentUser().role in ['operations', 'coordinator', 'system_admin', 'superadmin', 'director', 'projectadmin'];
    }
    match /academyDrafts/{courseId} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if academyAuthor() && request.resource.data.owner == request.auth.uid
        && request.resource.data.id == courseId && request.resource.data.revision == 1
        && request.resource.data.publishedRevision == 0;
      allow update: if academyAuthor() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner && request.resource.data.id == courseId
        && request.resource.data.revision == resource.data.revision + 1
        && resource.data.get('deletedAt', null) == null
        && request.resource.data.get('deletedAt', null) == null
        && request.resource.data.publishedRevision == resource.data.publishedRevision;
    }
    match /academyKeys/{revisionId} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
      allow write: if false;
    }
    match /academyVersions/{revisionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /academyCatalog/{courseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Training Academy staff read learners' enrollments for the course-progress
    // column on the Training SMEs pages. academyAuthor() is checked first so a
    // get of a not-yet-started (missing) enrollment is allowed rather than erroring.
    match /academyEnrollments/{enrollmentId} {
      allow read: if academyAuthor() || (request.auth != null && (resource.data.learnerId == request.auth.uid || resource.data.owner == request.auth.uid));
      allow write: if false;
    }
    // Trainings: name/duration/centers/categories set up by Training Academy staff.
    match /trainings/{trainingId} {
      allow read: if request.auth != null;
      allow create, update, delete: if academyAuthor();
    }
    // Training enrollments carry SME ID/qualification document links, so only
    // Training Academy staff (not every signed-in user) can read or write them.
    // A training SME (role training_sme) may read only their own record.
    match /trainingEnrollments/{enrollmentId} {
      allow read: if academyAuthor() || (request.auth != null && resource.data.get('userId', null) == request.auth.uid);
      allow create, update, delete: if academyAuthor();
    }
    // The people an SME sends (its director and employees). Staff read and
    // edit them; the SME's director reads all of the company's people; an
    // employee reads only their own record, never colleagues'. Directors add
    // and withdraw people through the manageTrainingAttendee function, which
    // also links logins (userId). progress is written only by the progress
    // function. A person can't be moved to another company or change kind.
    match /trainingAttendees/{attendeeId} {
      allow read, write: if isSuperAdmin();
      function validTrainingAttendee(data) {
        return data.enrollmentId is string && data.enrollmentId.size() > 0 &&
          data.trainingId is string &&
          data.kind in ['director', 'employee'] &&
          data.attends is bool &&
          (data.kind == 'director' || data.attends == true) &&
          (data.kind != 'director' || attendeeId == data.enrollmentId + '_director') &&
          data.name is string && data.name.size() > 0 &&
          data.email is string && data.email.size() > 3 &&
          data.categories is list &&
          data.status in ['active', 'withdrawn'];
      }
      allow read: if academyAuthor() ||
        (request.auth != null && resource.data.get('userId', null) == request.auth.uid) ||
        isTrainingCompanyDirector(resource.data.enrollmentId);
      allow create: if academyAuthor() &&
        validTrainingAttendee(request.resource.data) &&
        !request.resource.data.keys().hasAny(['progress', 'userId']);
      allow update: if academyAuthor() &&
        validTrainingAttendee(request.resource.data) &&
        request.resource.data.enrollmentId == resource.data.enrollmentId &&
        request.resource.data.kind == resource.data.kind &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress', 'userId']);
      allow delete: if false;
    }
    // Company totals (no names), kept by the progress function. Everyone in
    // the company reads them; employees see nothing per person here.
    match /trainingCompanyProgress/{enrollmentId} {
      allow read: if academyAuthor() || isTrainingCompanyMember(enrollmentId);
      allow write: if false;
    }
    // Certificates. Staff prepare drafts and send them for signature; once
    // anyone has signed, only the signing/issuing functions change a
    // certificate (signatures, number, PDF, hash, verification code, issue
    // and revoke). The company sees issued certificates: the director all of
    // them, an employee their own and the company's (attendeeId null).
    match /trainingCertificates/{certificateId} {
      allow read, write: if isSuperAdmin();
      allow read: if academyAuthor() ||
        (resource.data.status == 'issued' && (
          isTrainingCompanyDirector(resource.data.enrollmentId) ||
          (isTrainingCompanyMember(resource.data.enrollmentId) &&
            (resource.data.attendeeId == null ||
              resource.data.attendeeId == currentUser().get('trainingAttendeeId', '')))
        ));
      allow create: if academyAuthor() &&
        request.resource.data.status == 'draft' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.trainingId is string &&
        request.resource.data.enrollmentId is string &&
        request.resource.data.get('signatures', {}).size() == 0 &&
        !request.resource.data.keys().hasAny(['certificateNumber', 'pdfPath', 'pdfUrl', 'sha256',
          'verificationCode', 'issuedAt', 'revokedAt', 'revokedReason']);
      allow update: if academyAuthor() &&
        resource.data.status in ['draft', 'pending_signature'] &&
        resource.data.get('signatures', {}).size() == 0 &&
        request.resource.data.status in ['draft', 'pending_signature'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['recipientName', 'companyName', 'data', 'status', 'updatedAt']);
      allow delete: if academyAuthor() && resource.data.status == 'draft';
    }
    // Certificate templates: fillable PDFs managed by Training Academy staff.
    match /certificateTemplates/{templateId} {
      allow read, write: if isSuperAdmin();
      allow read: if academyAuthor();
      allow create, update: if academyAuthor() &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.active is bool &&
        request.resource.data.file.kind == 'pdf';
      allow delete: if false;
    }
    // Certificate numbers are handed out by the issuing function only.
    match /certificateCounters/{counterId} {
      allow read, write: if false;
    }
    // Training Academy settings, e.g. the global certification defaults
    // (trainingSettings/certification) that each training can override.
    match /trainingSettings/{settingId} {
      allow read: if request.auth != null;
      allow write: if academyAuthor();
    }
    // A notification is only visible to the users/roles it was addressed to.
    // A doc naming recipientIds is theirs alone; the role branch only covers
    // docs marked audience == 'role', which create below keeps free of
    // recipientIds. The marker (not "recipientIds is empty") is what makes
    // useNotificationCenter's role query provable: it filters on audience.
    // Server writers (admin SDK) must follow the same shape -- see
    // scripts/scope-notification-audience.cjs for the backfill.
    // Updates are restricted to marking it read so a recipient can't rewrite
    // its content or reassign it to someone else.
    function isNotificationRecipient(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['recipientIds']) && request.auth.uid in data.recipientIds) ||
        (
          data.keys().hasAny(['audience']) && data.audience == 'role' &&
          data.keys().hasAny(['recipientRoles']) && currentUser().role in data.recipientRoles
        );
    }
    match /notifications/{notificationId} {
      allow read: if request.auth != null && isNotificationRecipient(resource.data);
      allow create: if request.auth != null && (
        !request.resource.data.keys().hasAny(['audience']) ||
        (
          request.resource.data.audience == 'role' &&
          request.resource.data.get('recipientIds', []).size() == 0
        )
      );
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        isNotificationRecipient(resource.data);
      allow delete: if isSuperAdmin();
    }
    // Email-action tokens are minted and consumed only by Cloud Functions
    // (admin SDK bypasses rules) -- no client ever reads or writes these.
    match /notificationActions/{token} {
      allow read, write: if false;
    }
    // AI chat history — written only by the ai-backend's admin SDK on every
    // /chat turn (see save_chat_turn() in ai-backend/firestore_tools.py), so
    // the full conversation survives for later review/training even though
    // the app UI only resumes/lists today's sessions. A user may only ever
    // read their own sessions and messages; no client ever writes here.
    match /chatSessions/{sessionId} {
      allow read: if isSuperAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSuperAdmin() ||
          (request.auth != null && resource.data.userId == request.auth.uid);
        allow write: if false;
      }
    }
    // Programmes are created and configured only from the Programs page,
    // which the project admin and operations menus link to. Everyone signed
    // in still reads them (applicants and incubatees pick a programme to
    // register for). requiredDocs is edited on that page too.
    // deptRequirements is written from the Compliance page by staff, each
    // for their own department only, and the compliance resolver merges it
    // over the programme's requirements, so SMEs must never write it. Other
    // subcollections keep the general signed-in access they had before.
    function canManagePrograms() {
      return isSuperAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUser().role is string &&
        currentUser().role.lower().trim() in ['projectadmin', 'operations']
      );
    }
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow create, update, delete: if canManagePrograms();

      match /requiredDocs/{docId} {
        allow read: if request.auth != null;
        allow create, update, delete: if canManagePrograms();
      }

      match /deptRequirements/{departmentId} {
        allow read: if request.auth != null;
        allow write: if canManagePrograms() || (
          request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUser().role is string &&
          !(currentUser().role.lower().trim() in ['incubatee', 'participant', 'applicant']) &&
          currentUser().departmentId == departmentId
        );
      }

      match /{subcollection}/{rest=**} {
        allow read: if request.auth != null;
        allow write: if isStaff() &&
          !(subcollection in ['requiredDocs', 'deptRequirements']);
      }
    }
    // Collaborative reports: staff who write and review programme reports (project admins,
    // operations — report owners and department heads — and coordinators they hand
    // sections to). Never applicants or SMEs. Which sections each person may edit is
    // still checked in the app (reportPermissions.ts).
    function isReportStaff() {
      return isSuperAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUser().role is string &&
        currentUser().role.lower().trim() in ['projectadmin', 'operations', 'coordinator']
      );
    }
    match /reports/{reportId} {
      allow read, write: if isReportStaff();
    }
    match /reportBlocks/{blockId}/{rest=**} {
      allow read, write: if isReportStaff();
    }
    match /reportBlocks/{blockId} {
      allow read, write: if isReportStaff();
    }
    match /reportTemplates/{templateId} {
      allow read, write: if isReportStaff();
    }
    match /reportActivity/{activityId} {
      allow read, write: if isReportStaff();
    }
    // Assistant actions are proposed, confirmed and logged only by Cloud
    // Functions (functions/src/agentActions.ts, whatsappStaff.ts) through the
    // admin SDK. A user may read their own web proposals; nobody writes these
    // from a client, so the audit trail can't be edited or faked. System admins
    // still read auditLogs through the super-admin line below.
    match /agentProposals/{proposalId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /auditLogs/{logId} {
      allow read, write: if false;
    }
    match /whatsappAgentProposals/{proposalId} {
      allow read, write: if false;
    }
    match /whatsappAgentState/{userId} {
      allow read, write: if false;
    }
    // Nightly SME early-warning scores (functions/src/smeRiskScoring.ts). Staff
    // read them; SMEs never see their own risk rating; only the job writes.
    match /smeRiskSnapshots/{participantId} {
      allow read: if request.auth != null &&
        currentUser().role in ['director', 'operations', 'coordinator', 'projectadmin'];
      allow write: if false;
    }
    // Monthly intervention impact results (functions/src/interventionImpact.ts).
    // Staff and funders read them; only the job writes.
    match /interventionImpact/{resultId} {
      allow read: if request.auth != null &&
        currentUser().role in ['director', 'operations', 'coordinator', 'projectadmin', 'funder'];
      allow write: if false;
    }
    // Shared reference data external logins read too: catalogues, forms,
    // staff profiles (facilitators/HODs), events, and resource bookings for
    // the availability check. Writes stay with staff via the fallback below.
    match /{collectionId}/{docId} {
      allow read: if request.auth != null && collectionId in [
        'interventions', 'resources', 'resourceTypes', 'resourceAllocations', 'tutorials',
        'featureGovernance', 'events', 'kpiDefinitions', 'formTemplates', 'departmentForms',
        'sentForms', 'system_settings', 'coordinators', 'consultants', 'operationsStaff',
        'qmsStandards'
      ];
    }

    // ---- External logins: only their own records ----
    // SME screens probe guessed ids (participants/{uid}, applications/{pid})
    // before falling back to an email query, so a get of a missing doc is
    // allowed; it reveals only that nothing is there.
    match /participants/{participantId} {
      allow get: if request.auth != null && resource == null;
      allow read: if isMyEmail(resource.data.email) ||
        (hasProfile() && currentUser().get('participantId', '') == participantId);
      allow read: if isFunderUser();
      // The applicant profile creates the record with the login's email.
      allow create: if isMyEmail(request.resource.data.email);
      allow update: if isMyEmail(resource.data.email) && isMyEmail(request.resource.data.email);
    }

    match /applications/{applicationId} {
      allow get: if request.auth != null && resource == null;
      allow read: if ownsApplicationData(resource.data);
      allow read: if funderSeesProgram(resource.data.programId);
      allow create: if ownsApplicationData(request.resource.data) &&
        request.resource.data.get('applicationStatus', 'pending') == 'pending';
      // SMEs sign agreements and record their own progress on the
      // application; the decision and identity fields are staff's.
      allow update: if ownsApplicationData(resource.data) && ownsApplicationData(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'applicationStatus', 'status', 'decision', 'participantId', 'programId', 'email',
          'applicantEmail', 'acceptedAt', 'acceptedBy', 'romSignatureURL', 'aiEvaluation',
          'aiEvaluationStatus'
        ]);

      // agreements, complianceDocuments, ... An SME uploads documents as
      // pending; only staff mark them valid.
      match /{subcollection}/{docId} {
        allow read: if ownsApplication(applicationId);
        allow create: if ownsApplication(applicationId) &&
          (subcollection != 'complianceDocuments' || request.resource.data.get('status', 'pending') == 'pending');
        allow update: if ownsApplication(applicationId) &&
          (subcollection != 'complianceDocuments' ||
            request.resource.data.get('status', 'pending') in ['pending', resource.data.get('status', 'pending')]);
      }
    }

    match /applicationDrafts/{draftId} {
      allow read, delete: if ownsParticipant(draftId);
      allow create, update: if ownsParticipant(draftId) &&
        request.resource.data.get('participantId', draftId) == draftId;
    }

    match /diagnosticPlans/{planId} {
      allow read: if ownsParticipant(resource.data.participantId);
      allow update: if ownsParticipant(resource.data.participantId) &&
        request.resource.data.participantId == resource.data.participantId;
    }

    match /gapAnalysis/{gapId} {
      allow read: if ownsParticipant(resource.data.participantId);
      allow create: if ownsParticipant(request.resource.data.participantId);
    }

    match /interventionRequests/{requestId} {
      allow read: if ownsParticipant(resource.data.participantId);
      allow create: if ownsParticipant(request.resource.data.participantId);
    }

    match /smeFeedback/{feedbackId} {
      allow read: if ownsSmeRecord(resource.data.participantId);
      allow create: if ownsSmeRecord(request.resource.data.participantId);
      allow update: if ownsSmeRecord(resource.data.participantId) &&
        request.resource.data.participantId == resource.data.participantId;
    }

    match /monthlyPerformance/{participantId}/{rest=**} {
      allow read: if ownsParticipant(participantId);
    }

    // An SME's evidence pack, found through its assignment or development plan.
    match /movDocuments/{movId} {
      function smeOwnsMov(data) {
        return ownsParticipant(data.participantId) || ownsParticipant(data.smmeId) ||
          ownsAssignment(data.assignedInterventionId) ||
          ownsParticipant(get(/databases/$(database)/documents/diagnosticPlans/$(data.diagnosticPlanId)).data.participantId);
      }
      allow read, update: if smeOwnsMov(resource.data);
      allow create: if smeOwnsMov(request.resource.data);
    }

    // Queries the SME raised, or that are about one of their assignments.
    match /workflowQueries/{queryId} {
      function smeOwnsQuery(data) {
        return data.raisedById == request.auth.uid ||
          ownsParticipant(data.context.participantId) ||
          ownsAssignment(data.target.id);
      }
      allow read, update: if request.auth != null && smeOwnsQuery(resource.data);
      allow create: if request.auth != null && request.resource.data.raisedById == request.auth.uid;
    }

    // Each SME's KPI progress; the programme summary is recalculated in the
    // SME's own transaction (lib/kpis.ts), so SMEs keep write access to it.
    match /kpiProgress/{programId}/participants/{participantId} {
      allow read, write: if ownsParticipant(participantId);
    }
    match /kpiProgress/{programId}/summary/{summaryId} {
      allow read, write: if hasProfile() && myRole() in ['incubatee', 'participant'];
    }

    // Survey responses are keyed by participant id (older ones by uid or email).
    match /sentForms/{formId}/responses/{responseId} {
      allow read, create, update: if ownsParticipant(responseId) ||
        responseId == request.auth.uid || isMyEmail(responseId);
    }
    match /{path=**}/responses/{responseId} {
      allow read: if ownsParticipant(resource.data.participantId);
    }

    match /resourceRequests/{requestId} {
      allow read: if isMyEmail(resource.data.requestedByEmail) || isMyEmail(resource.data.requestedBy) ||
        (hasProfile() && resource.data.requestedBy == currentUser().get('name', ''));
      allow create: if isMyEmail(request.resource.data.requestedByEmail);
    }

    match /userSessions/{sessionId} {
      allow read, update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // The invoice prompt runs for every login and only ever matches HODs.
    match /consolidatedMOVs/{movId} {
      allow read: if request.auth != null && resource.data.hodUid == request.auth.uid;
    }

    // Funders work the task board (components/tasks/TaskModule.tsx).
    match /tasks/{taskId} {
      allow read, write: if isFunderUser();
    }

    // Everything else is internal staff only. Super-admins can access every
    // collection, including the explicitly restricted collections above.
    match /{collectionId}/{document=**} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isStaff() &&
        !(collectionId in ['users', 'agentProposals', 'auditLogs', 'whatsappAgentProposals', 'whatsappAgentState', 'smeRiskSnapshots', 'interventionImpact', 'academyDrafts', 'academyKeys', 'academyVersions', 'academyCatalog', 'academyEnrollments', 'trainings', 'trainingEnrollments', 'trainingAttendees', 'trainingCompanyProgress', 'trainingCertificates', 'certificateTemplates', 'certificateCounters', 'trainingSettings', 'noticeBoard', 'agreementTemplates', 'projectProposals', 'proposalCounters', 'qualityObjectives', 'leaveRequests', 'appointments', 'appointmentSessions', 'notifications', 'notificationActions', 'chatSessions', 'programs', 'outcomeFollowUps', 'outcomeAssessments', 'interventionClosures', 'reports', 'reportBlocks', 'reportTemplates', 'reportActivity']);
    }
  }
}
