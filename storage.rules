rules_version = '2';

// NOTE: this file does not yet cover every path the app uploads to -- see the
// inventory in the audit note below. Two cautions when extending it:
//
//  * A path with no matching rule is denied, so an upload added to the app
//    needs its rule added in the same change.
//  * Do NOT "fix" that with a catch-all `match /{allPaths=**}`. Storage grants
//    access when ANY matching rule allows it, so a permissive catch-all would
//    silently override every restriction here, including canAccessProposals().
service firebase.storage {
  match /b/{bucket}/o {
    match /library/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /intervention-evidence/{programId}/{participantId}/{assignmentId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size <= 25 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Compliance documents captured during application and onboarding, by the
    // participant themselves (routes/registration/onboarding) and by a
    // consultant on their behalf (routes/operations/participants/new).
    // Nothing in the app deletes these: a superseded document is replaced by
    // uploading a newer one, which keeps the audit trail intact.
    match /participant_documents/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Countersigned agreement PDFs, rendered and uploaded after a contract is
    // signed (src/utils/generateContractPdf.ts). Written once per signing;
    // a re-signing adds a new timestamped file rather than replacing one.
    match /agreements/{participantId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size <= 25 * 1024 * 1024;
      allow update, delete: if false;
    }

    function canAccessProposals() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role is string &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role.lower().trim() != 'incubatee';
    }

    match /projectProposals/{companyCode}/{proposalId}/{folder}/{fileName} {
      allow read: if canAccessProposals();
      allow create, update: if canAccessProposals()
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if canAccessProposals();
    }

    // routes/programs uploads proposal files one segment shallower than
    // services/proposalService.ts does; both are staff-only.
    match /projectProposals/{proposalId}/{folder}/{fileName} {
      allow read: if canAccessProposals();
      allow create, update: if canAccessProposals()
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if canAccessProposals();
    }

    match /feature-releases/{releaseId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if request.auth != null;
    }
  }
}
